<?xml version="1.0" encoding="UTF-8"?>
<openfluid format="fluidx 4">
    <model>
        <generator varname="var3" unitsclass="unitsA" type="double" enabled="true" method="inject">
            <param name="sources" value="unitsA-var3-sources.xml"/>
            <param name="distribution" value="unitsA-var3-distribution.xml"/>
        </generator>
        <generator varname="var2" unitsclass="unitsA" type="double" enabled="true" method="inject">
            <param name="sources" value="unitsA-var2-sources.xml"/>
            <param name="distribution" value="unitsA-var2-distribution.xml"/>
        </generator>
        <simulator ID="examples.primitives.unitsB.prod" enabled="true"/>
    </model>
</openfluid>