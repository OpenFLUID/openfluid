<?xml version="1.0" encoding="UTF-8"?>
<openfluid format="fluidx 4">
    <model>
        <generator varname="var2" unitsclass="unitsA" type="double" method="inject" enabled="true">
            <param name="sources" value="unitsA-var2-sources.xml"/>
            <param name="distribution" value="unitsA-var2-distribution.xml"/>
        </generator>
        <generator varname="var11" unitsclass="unitsA" type="double" method="inject" enabled="true">
            <param name="sources" value="unitsA-var11-sources.xml"/>
            <param name="distribution" value="unitsA-var11-distribution.xml"/>
        </generator>
        <generator varname="var10" unitsclass="unitsA" type="double" method="inject" enabled="true">
            <param name="sources" value="unitsA-var10-sources.xml"/>
            <param name="distribution" value="unitsA-var10-distribution.xml"/>
        </generator>
        <generator varname="var1" unitsclass="unitsA" type="double" method="inject" enabled="true">
            <param name="sources" value="unitsA-var1-sources.xml"/>
            <param name="distribution" value="unitsA-var1-distribution.xml"/>
        </generator>
        <simulator ID="examples.primitives.unitsA.up" enabled="true">
            <param name="gmult" value="3"/>
        </simulator>
    </model>
</openfluid>