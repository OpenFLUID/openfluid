   <param name="serie.s2.label" value="water.surf.Q.downstream-su133"/>
   <param name="serie.s2.style" value="lines"/>
   <param name="serie.s2.unitID" value="133"/>
   <param name="serie.s2.unitsclass" value="SU"/>
   <param name="serie.s2.var" value="water.surf.Q.downstream-su"/>
