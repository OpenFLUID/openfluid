   <param name="graph.g3.title" value="Downstream on RS372"/>
   <param name="graph.g3.ylabel" value="Downstream"/>
   <param name="graph.g4.key" value="default"/>
   <param name="graph.g4.series" value="s1;s2;s3"/>
   <param name="graph.g4.title" value="Simulated downstreams"/>
   <param name="graph.g4.ylabel" value="Downstream"/>
   <param name="output" value="simulation_results .pdf"/>
   <param name="persistent" value="0"/>
